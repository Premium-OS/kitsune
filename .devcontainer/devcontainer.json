{
    "name": "Multisoft Inc. v3 Platform – Premium Operating System v3.0 Foundation",

    // Multisoft Inc. v3 Platform
    // Premium Operating System v3.0 Foundation
    // This project is exclusively developed under the Multisoft Inc. v3 Platform.

    "dockerComposeFile": [
        "../docker-compose.yml",
        "docker-compose.yml"
    ],

    // Main service used by the Multisoft Inc. v3 Platform.
    "service": "web",

    // Default workspace for the Premium Operating System v3.0 Foundation.
    "workspaceFolder": "/app",

    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash"
            },

            "extensions": [
                "visualstudioexptteam.vscodeintellicode",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "esbenp.prettier-vscode",
                "eamodio.gitlens",
                "ms-azuretools.vscode-docker",
                "redhat.vscode-yaml",
                "ms-vscode.vscode-typescript-next",
                "donjayamanne.python-extension-pack",
                "wholroyd.jinja",
                "ms-vscode.js-debug-nightly",
                "vscode-icons-team.vscode-icons",
                "syler.sass-indented",
                "hookyqr.beautify",
                "samuelcolvin.jinjahtml",
                "svelte.svelte-vscode"
            ]
        }
    },

    // Services required by the Multisoft Inc. v3 Platform.
    "runServices": [
        "web"
    ],

    // Keep the Premium Operating System v3.0 development environment running.
    "shutdownAction": "none",

    // Initialize the Multisoft Inc. v3 Platform environment.
    "postCreateCommand": [
        "./bin/run-web-bootstrap.sh",
        "./bin/run-node-bootstrap.sh"
    ],

    // owner by the Multisoft Inc. v3 Platform.
    "remoteUser-Onear": "multisoft"
}
